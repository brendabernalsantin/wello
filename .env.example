# Configuración pública que el build convierte en window.WELLO_CONFIG.
# Solo usa la URL del proyecto y la publishable/anon key de Supabase.
# Nunca pongas aquí service_role, sb_secret_ ni secretos de Google.
WELLO_SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
WELLO_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TU_CLAVE_PUBLICA
# preview permite probar sin publicación; production exige URL HTTPS y ambas variables.
WELLO_DEPLOY_MODE=preview
